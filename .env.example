# kvorum — provider credentials + run settings (chmod 600, never commit)
#
# Secrets precedence: process environment -> env files (.env by default;
# --env-file / KVORUM_ENV_FILE replace it, earlier files win in a ":"-separated
# list). Keys are used only in Authorization headers and never printed.
# Each provider's `api_key_env` list declares which variable names it reads;
# here we document the built-in providers. Local providers (Ollama/vLLM) usually
# need no key — set OLLAMA_API_KEY= to any value if a key is still required.

# --- Provider credentials ---
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
# SILICONFLOW_KEY=     # fallback alias for SiliconFlow
# OLLAMA_API_KEY=      # optional for a local OpenAI-compatible endpoint

# --- Per-provider base URL overrides (optional; custom endpoint / local proxy) ---
# SILICONFLOW_BASE_URL=http://127.0.0.1:8000/v1   # vLLM / LiteLLM gateway
# OPENROUTER_BASE_URL=http://127.0.0.1:8080/v1
# DEEPSEEK_BASE_URL=http://127.0.0.1:8081/v1
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1       # e.g. an Ollama OpenAI endpoint

# --- Run settings (KVORUM_* overrides; otherwise taken from panel.json) ---
# KVORUM_PANEL=examples/panel.openrouter.json
# KVORUM_PACKET=packet.md
# KVORUM_RULES=rules.md
# KVORUM_RUNS_DIR=runs
# KVORUM_VERDICT=verdict.md
# KVORUM_VERDICT_JSON=verdict.json
# KVORUM_ENV_FILE=.env
# KVORUM_TIMEOUT_S=600
# KVORUM_FALLBACK_TIMEOUT_S=300
# KVORUM_MAX_TOKENS_RETRY=32768
# KVORUM_QUORUM_REQUIRED=3
# KVORUM_FAIL_CLOSED=true
# KVORUM_MIN_DELAY_S=10
# COUNCIL_EXCLUDE_MODELS=         # override the shipped seat-exclusion list

# --- Completion notifications (optional) ---
# KVORUM_NTFY_TOPIC=kvorum-<your-topic>   # ntfy.sh push on run completion
# KVORUM_NOTIFY_WEBHOOK=https://hooks.example.com/kvorum   # generic JSON webhook

